# Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Appwrite Configuration
NEXT_PUBLIC_APPWRITE_PROJECT_ID=<PROJECT_ID>
NEXT_PUBLIC_APPWRITE_PROJECT_NAME=Grovy
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_API_KEY=<APPWRITE_API_KEY>
NEXT_PUBLIC_APPWRITE_DATABASE_ID=grovy_main


# PWA Configuration
NEXT_PUBLIC_APP_NAME=Minimalist Music Player
NEXT_PUBLIC_APP_DESCRIPTION=A minimalist music player PWA with offline support

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_SHARE=true
