{
  "name": "grovy",
  "version": "1.0.0",
  "description": "Premium open-source web music player crafted with Next.js and Tailwind CSS",
  "private": false,
  "author": "Gaurav Rambaran Yadav (archduke1337)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/archduke1337/grovy.git"
  },
  "keywords": [
    "music-player",
    "nextjs",
    "react",
    "tailwindcss",
    "open-source",
    "framer-motion",
    "audio-visualizer",
    "pwa"
  ],
  "homepage": "https://grovy.archduke1337.is-a.dev",
  "bugs": {
    "url": "https://github.com/archduke1337/grovy/issues"
  },
  "scripts": {
    "dev": "node scripts/generate-manifest.js && next dev",
    "build": "node scripts/generate-manifest.js && next build",
    "start": "next start",
    "lint": "eslint app __tests__ scripts --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "appwrite:setup": "node scripts/setup-appwrite.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.6",
    "@tailwindcss/postcss": "^4.1.18",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^2.2.0",
    "appwrite": "^24.0.0",
    "autoprefixer": "^10.4.0",
    "colorthief": "^3.5.0",
    "framer-motion": "^11.5.6",
    "hls.js": "^1.6.15",
    "lenis": "^1.3.17",
    "lucide-react": "^0.263.1",
    "next": "^16.4.3",
    "node-appwrite": "^23.0.0",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^28.1.0",
    "vitest": "^5.0.5"
  }
}
